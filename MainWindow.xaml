<Window x:Class="RivalsCounter.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rivals Counter" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" UseAeroCaptionButtons="True"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Root" Margin="0">
    <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
      <TextBlock Text="Rivals Counter" FontWeight="SemiBold" FontSize="14" x:Name="TitleText"/>
      <TextBlock x:Name="PatchText" Margin="12,0,0,0" Opacity="0.6" VerticalAlignment="Center" FontSize="12"/>
    </StackPanel>
    <DockPanel Grid.Row="1" Margin="16,4,16,8" LastChildFill="False">
      <Border x:Name="SearchBorder" CornerRadius="8" Padding="10,0" Height="34" Width="260" DockPanel.Dock="Left">
        <Grid>
          <TextBlock x:Name="SearchHint" Text="Kahraman ara… (yaz + Enter)" Opacity="0.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBox x:Name="Search" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
      </Border>
      <StackPanel x:Name="ViewBar" Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,0,0,0"/>
      <StackPanel x:Name="ModeBar" Orientation="Horizontal" DockPanel.Dock="Left" Margin="12,0,0,0"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" x:Name="RightBar"/>
    </DockPanel>
    <Grid Grid.Row="2" Margin="16,0,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border x:Name="SlotsCard" CornerRadius="12" Padding="12" Margin="0,0,0,12">
        <StackPanel x:Name="Slots"/>
      </Border>
      <Border x:Name="GridCard" Grid.Row="1" CornerRadius="12" Padding="12,8">
        <ScrollViewer x:Name="LeftScroll" VerticalScrollBarVisibility="Auto"><Grid><StackPanel x:Name="HeroGrid"/><StackPanel x:Name="MetaPanel" Visibility="Collapsed"/></Grid></ScrollViewer>
      </Border>
      <Border x:Name="RecCard" Grid.Column="2" Grid.RowSpan="2" CornerRadius="12" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Recs"/></ScrollViewer>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="Status" Margin="16,0,16,8" FontSize="11" Opacity="0.55" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
