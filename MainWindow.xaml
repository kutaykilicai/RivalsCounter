<Window x:Class="RivalsCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rivals Counter" Width="1120" Height="860" MinWidth="920" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="Transparent" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="56" ResizeBorderThickness="6"
                  CornerRadius="12" UseAeroCaptionButtons="True"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root" Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="56"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <DockPanel Margin="24,0,16,0" LastChildFill="False">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="Rivals Counter" Style="{StaticResource Title}"/>
        <TextBlock x:Name="PatchText" Style="{StaticResource Caption}" Margin="0,1,0,0" Text="Season 10.5 · 4 Kas"/>
      </StackPanel>
      <StackPanel x:Name="RightBar" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,24,16"
                  CanContentScroll="False">
      <StackPanel x:Name="MainStack" MaxWidth="1080" HorizontalAlignment="Stretch">

        <!-- Drop zone -->
        <Border x:Name="DropZone" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,18"
                Cursor="Hand" AllowDrop="True" MinHeight="108">
          <Grid>
            <StackPanel x:Name="DropIdle" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE91B;" FontSize="28"
                         Foreground="{StaticResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
              <TextBlock x:Name="DropTitle" Text="Ekran görüntüsü ekle" FontSize="16" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Foreground="{DynamicResource Text}"/>
              <TextBlock x:Name="DropHint" Text="Ctrl+V · sürükle-bırak · Ctrl+Shift+S ile yakala"
                         Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,14"
                         TextAlignment="Center"/>
              <Button x:Name="BtnCapture" Content="Ekranı yakala" Padding="16,8" Cursor="Hand"
                      Focusable="False" HorizontalAlignment="Center"/>
            </StackPanel>
            <DockPanel x:Name="DropDone" Visibility="Collapsed" LastChildFill="True">
              <Border Width="132" Height="74" CornerRadius="10" ClipToBounds="True" Margin="0,0,16,0"
                      BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" DockPanel.Dock="Left">
                <Image x:Name="Thumb" Stretch="UniformToFill"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DropDoneTitle" Text="Görüntü alındı" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock x:Name="DropDoneHint" Style="{StaticResource Caption}" Margin="0,4,0,0"
                           Text="Chip’leri düzeltmek için ara · yeniden yakalamak için tıkla"/>
              </StackPanel>
              <Button x:Name="BtnRecapture" Content="Yeniden" Padding="12,7" Cursor="Hand"
                      Focusable="False" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
          </Grid>
        </Border>

        <!-- Teams card -->
        <Border x:Name="TeamsCard" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18,16">
          <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,14">
              <TextBlock Text="TAKIMLAR" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="2,0,0,0"/>
              <Border x:Name="SearchBorder" CornerRadius="999" Padding="14,0" Height="34" Width="220"
                      DockPanel.Dock="Right" Background="{DynamicResource InputBg}"
                      BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1" Margin="10,0,0,0">
                <Grid>
                  <TextBlock x:Name="SearchHint" Text="Düzelt…" Opacity="0.45" VerticalAlignment="Center"
                             IsHitTestVisible="False" FontSize="12.5"/>
                  <TextBox x:Name="Search" BorderThickness="0" Background="Transparent"
                           VerticalAlignment="Center" FontSize="13" CaretBrush="{DynamicResource Text}"
                           Foreground="{DynamicResource Text}"/>
                </Grid>
              </Border>
              <Border x:Name="SegHost" CornerRadius="999" Background="{DynamicResource PillBg}" Padding="3"
                      DockPanel.Dock="Right" BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1">
                <StackPanel x:Name="ModeBar" Orientation="Horizontal"/>
              </Border>
            </DockPanel>
            <StackPanel x:Name="Slots"/>
          </StackPanel>
        </Border>

        <!-- Insights grouped -->
        <Border x:Name="InsightCard" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="6,4"
                Visibility="Collapsed">
          <StackPanel x:Name="InsightPanel"/>
        </Border>

        <!-- Counters + Meta -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="320"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="RecCard" Style="{StaticResource Card}" Padding="18">
            <StackPanel>
              <TextBlock Text="Counter önerileri" FontFamily="{StaticResource DisplayFont}"
                         FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <StackPanel x:Name="Recs"/>
            </StackPanel>
          </Border>
          <Border x:Name="MetaCard" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
            <StackPanel>
              <TextBlock Text="Güncel meta" FontFamily="{StaticResource DisplayFont}"
                         FontSize="17" FontWeight="SemiBold"/>
              <TextBlock x:Name="MetaSub" Style="{StaticResource Caption}" Margin="0,4,0,12"
                         TextWrapping="Wrap"/>
              <StackPanel x:Name="MetaPanel"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" x:Name="Status" Margin="24,0,24,12" FontSize="11"
               Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
