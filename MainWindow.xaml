<Window x:Class="RivalsCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rivals Counter" Width="1180" Height="820" MinWidth="960" MinHeight="680"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        AllowDrop="True">
  <WindowChrome.WindowChrome>
    <WindowChrome GlassFrameThickness="-1" CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="12" UseAeroCaptionButtons="True"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <DockPanel Margin="18,0,12,0" LastChildFill="False">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="Rivals Counter" FontWeight="SemiBold" FontSize="15"/>
        <TextBlock x:Name="PatchText" Margin="12,0,0,0" Opacity="0.55" VerticalAlignment="Center" FontSize="12"/>
      </StackPanel>
      <StackPanel x:Name="RightBar" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,18,8">
      <StackPanel x:Name="MainStack">
        <!-- Capture zone -->
        <Border x:Name="DropZone" CornerRadius="14" Padding="16" Margin="0,0,0,14" BorderThickness="1.5" Cursor="Hand"
                AllowDrop="True" MinHeight="92">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="DropTitle" Text="Ekran görüntüsü yapıştır veya sürükle" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock x:Name="DropHint" Text="Ctrl+V · sürükle-bırak · Ctrl+Shift+S ile ekranı yakala  ·  maç/Tab/seçim ekranı" FontSize="12" Opacity="0.6" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="ThumbWrap" Width="120" Height="68" CornerRadius="10" Margin="0,0,10,0" Visibility="Collapsed" ClipToBounds="True">
                <Image x:Name="Thumb" Stretch="UniformToFill"/>
              </Border>
              <Button x:Name="BtnCapture" Content="Ekranı yakala" Padding="14,8" Cursor="Hand" Focusable="False"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Detected teams -->
        <Border x:Name="TeamsCard" CornerRadius="14" Padding="14" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel LastChildFill="False" Margin="0,0,0,8">
              <TextBlock Text="Algılanan takımlar" FontSize="13" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center"/>
              <Border x:Name="SearchBorder" CornerRadius="9" Padding="10,0" Height="32" Width="220" DockPanel.Dock="Right" Margin="8,0,0,0">
                <Grid>
                  <TextBlock x:Name="SearchHint" Text="Düzelt: kahraman ara…" Opacity="0.45" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="12"/>
                  <TextBox x:Name="Search" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13"/>
                </Grid>
              </Border>
              <StackPanel x:Name="ModeBar" Orientation="Horizontal" DockPanel.Dock="Right"/>
            </DockPanel>
            <StackPanel x:Name="Slots"/>
          </StackPanel>
        </Border>

        <!-- Insights -->
        <StackPanel x:Name="InsightPanel" Margin="0,0,0,12"/>

        <!-- Counters + Meta -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="340"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="RecCard" CornerRadius="14" Padding="14">
            <StackPanel>
              <TextBlock Text="Counter önerileri" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <StackPanel x:Name="Recs"/>
            </StackPanel>
          </Border>
          <Border x:Name="MetaCard" Grid.Column="2" CornerRadius="14" Padding="14">
            <StackPanel>
              <TextBlock Text="Güncel meta" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBlock x:Name="MetaSub" FontSize="11" Opacity="0.55" Margin="0,0,0,8" TextWrapping="Wrap"/>
              <StackPanel x:Name="MetaPanel"/>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" x:Name="Status" Margin="18,0,18,10" FontSize="11" Opacity="0.5" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
